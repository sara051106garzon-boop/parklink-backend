# ─────────────────────────────────────────────────────────────────────────────
# ParkLink Back-End — variables de entorno (EJEMPLO, sin secretos reales).
#
# Copia este archivo a `.env` en el servidor y reemplaza los valores por los
# reales. Docker Compose lee `.env` automáticamente para interpolar ${VAR}.
# NUNCA subas el `.env` real al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de despliegue: staging | production | local (sufijo de contenedores/redes).
PARKLINK_ENV=production

# Puerto público del backend en el host: 8000 (staging) / 8001 (production).
# Dentro del contenedor la app escucha SIEMPRE en 5000 (ver Dockerfile).
APP_PORT=8001

# Base de datos MySQL. El host "db" es el servicio interno de docker-compose.
# Usuario/clave/base deben coincidir con DB_USER / DB_PASSWORD / DB_NAME.
DATABASE_URL=mysql+pymysql://parklink:CAMBIA_ESTA_CLAVE@db:3306/parklink_production

# Credenciales del contenedor MySQL (deben coincidir con DATABASE_URL).
DB_USER=parklink
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_NAME=parklink_production

# Claves secretas. Genera cadenas largas y aleatorias (nunca uses estos valores).
SECRET_KEY=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO
JWT_SECRET_KEY=CAMBIA_ESTE_SECRETO_JWT_LARGO_Y_ALEATORIO

# Desactiva el modo debug en producción.
FLASK_DEBUG=0

# Orígenes permitidos por CORS y WebSockets (separados por coma). El frontend en
# Vercel llama al mismo origen (proxy /api/*), pero se recomienda listar el dominio.
CORS_ORIGINS=https://parklink-app.vercel.app

# Email (Flask-Mailman) — opcional, solo para notificaciones/reportes.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
